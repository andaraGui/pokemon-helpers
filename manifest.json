{
  "manifest_version": 3,
  "name": "IfinityMMO Helper",
  "version": "1.4.50",
  "description": "",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*", "https://raw.githubusercontent.com/andaraGui/pokemon-helpers/*"],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Abrir/fechar o overlay do Pokemon Helper"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "app.js",
        "battle.html",
        "battle.js",
        "chart.html",
        "chart.js",
        "pixel-theme.css",
        "myPokemons.html",
        "myPokemons.js",
        "components/*.js",
        "components/*.css",
        "data/*.js",
        "icons/types/*.png",
        "icons/types/colored/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
