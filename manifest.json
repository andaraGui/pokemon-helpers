{
  "manifest_version": 3,
  "name": "IfinityMMO Helper",
  "version": "1.4.17",
  "description": "",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Abrir/fechar o overlay do Pokemon Helper"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "app.js", "battle.html", "battle.js", "pixel-theme.css", "myPokemons.html", "myPokemons.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
