{
  "manifest_version": 3,
  "name": "IfinityMMO Helper",
  "version": "1.3.1",
  "description": "",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "app.js", "battle.html", "battle.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
