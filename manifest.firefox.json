{
  "manifest_version": 3,
  "name": "IfinityMMO Helper",
  "version": "1.4.40",
  "description": "",
  "action": {},
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*"],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Abrir/fechar o overlay do Pokemon Helper"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "app.js", "battle.html", "battle.js", "chart.html", "chart.js", "pixel-theme.css", "myPokemons.html", "myPokemons.js", "components/*.js", "components/*.css", "icons/types/*.png", "icons/types/colored/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ifinitymmo-helper@andaragui",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
